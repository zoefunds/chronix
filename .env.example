# Chronix — environment variables (example). Copy to .env and fill in.

# --- GenLayer Intelligent Contract ---
# Deploy contracts/chronix.py manually to GenLayer Studio / StudioNet,
# then paste the resulting address here. Backend reads this at boot.
CONTRACT_ADDRESS=0xF0308C069Fb536D334926A01d2d625467fe77b0e

# GenLayer StudioNet RPC endpoint (placeholder — replace with the real
# StudioNet URL from the GenLayer Studio dashboard / CLI `genlayer network` output).
GENLAYER_RPC_URL=https://studio.genlayer.com/api/rpc
GENLAYER_NETWORK=studionet
GENLAYER_GAS_TOKEN=GEN

# Frontend (Vite) equivalents — mirrors CONTRACT_ADDRESS / RPC above.
VITE_API_URL=http://localhost:3000
VITE_CONTRACT_ADDRESS=0xF0308C069Fb536D334926A01d2d625467fe77b0e
VITE_CHAIN_RPC=https://studio.genlayer.com/api/rpc

# --- Database (Postgres, per PLANNING.md) ---
DATABASE_URL=postgres://chronix:changeme@localhost:5432/chronix

# --- Backend ---
PORT=3000
NODE_ENV=development
