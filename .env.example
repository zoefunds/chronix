# Chronix — environment variables (example, repo-root overview only).
# The authoritative, fully-commented files are backend/.env.example and
# frontend/.env.example — copy those into backend/.env / frontend/.env.
# This file exists as a quick top-level reference only.

# --- GenLayer Intelligent Contract (adjudication + ledger only — moves no
# money; see contracts/chronix.py) ---
# Deploy contracts/chronix.py manually to GenLayer Studio / StudioNet with
# relayer_address = the backend relayer wallet's address, then paste the
# resulting address here.
CONTRACT_ADDRESS=
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999

# --- Base Sepolia (real USDC funding layer — contracts/base/ChronixEscrow.sol) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
CHRONIX_ESCROW_ADDRESS=

# --- Backend relayer (gates every GenLayer write AND signs ChronixEscrow
# setPayouts on Base Sepolia — see backend/src/genlayer/client.ts and
# backend/src/services/baseSepolia.ts) ---
RELAYER_PRIVATE_KEY=
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=

# Frontend (Vite) equivalents — mirrors the values above.
VITE_API_URL=http://localhost:8080
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_RPC=https://studio.genlayer.com/api
VITE_BASE_SEPOLIA_CHAIN_ID=84532
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_CHRONIX_ESCROW_ADDRESS=

# --- Database (Postgres, per PLANNING.md) ---
DATABASE_URL=postgres://chronix:changeme@localhost:5432/chronix

# --- Backend ---
PORT=8080
NODE_ENV=development
