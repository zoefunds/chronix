# EchoMarkets backend environment configuration.
# Copy to .env for local dev: cp .env.example .env

# --- Server ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Postgres ---
DATABASE_URL=postgres://echomarkets:echomarkets@localhost:5432/echomarkets
DATABASE_SSL=false

# --- Auth (SIWE + JWT sessions) ---
JWT_SECRET=replace-with-a-long-random-string-in-production
JWT_EXPIRES_IN=24h
SIWE_DOMAIN=echomarkets.xyz
SIWE_URI=https://echomarkets.xyz

# --- CORS ---
# Comma-separated list of allowed origins (Vercel frontend + local dev).
CORS_ORIGIN=http://localhost:5173,https://echomarkets.vercel.app

# --- GenLayer ---
# Set once the Intelligent Contract is deployed by the user. Left blank until then;
# the GenLayer client wrapper no-ops with clear errors while unset.
CONTRACT_ADDRESS=0xF0308C069Fb536D334926A01d2d625467fe77b0e
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999

# --- Optional read cache (Redis / Upstash) ---
# Best-effort only — never load-bearing. Leave blank to disable caching
# entirely; jobs and payout logic are Postgres-backed regardless.
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=15

# --- Background jobs ---
DEADLINE_ENFORCER_INTERVAL_MS=60000
CHAIN_RECONCILER_INTERVAL_MS=15000
CHAIN_SYNC_MAX_ATTEMPTS=8
CHAIN_SYNC_BASE_BACKOFF_MS=2000
