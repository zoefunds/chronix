# Chronix backend environment configuration.
# Copy to .env for local dev: cp .env.example .env

# --- Server ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Postgres ---
DATABASE_URL=postgres://chronix:chronix@localhost:5432/chronix
DATABASE_SSL=false

# --- Auth (SIWE + JWT sessions) ---
JWT_SECRET=replace-with-a-long-random-string-in-production
JWT_EXPIRES_IN=24h
SIWE_DOMAIN=chronix-app.vercel.app
SIWE_URI=https://chronix-app.vercel.app

# --- CORS ---
# Comma-separated list of allowed origins (Vercel frontend + local dev).
CORS_ORIGIN=http://localhost:5173,https://chronix-app.vercel.app

# --- GenLayer (adjudication + ledger only — moves no money; see contracts/chronix.py) ---
# Set once you deploy chronix.py on GenLayer Studio. Its constructor now
# takes relayer_address, which MUST equal RELAYER_PRIVATE_KEY's address below.
CONTRACT_ADDRESS=
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
# Relayer account: gates every write on chronix.py (create_market, stake,
# claim_payout, claim_timeout_refund, cancel_market — all money-free ledger
# mirrors of Base Sepolia activity, see contracts/chronix.py) AND the two
# permissionless keeper actions (request_adjudication, settle). Never holds
# or moves user funds itself. Leave blank to disable both the relay and
# keeper jobs (markets can still be advanced manually by any wallet calling
# the same public request_adjudication/settle methods).
RELAYER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=30000
BASE_RELAY_INTERVAL_MS=20000

# --- Base Sepolia (real USDC funding layer — contracts/base/ChronixEscrow.sol) ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Set once you deploy ChronixEscrow.sol (contracts/base/deploy.js).
CHRONIX_ESCROW_ADDRESS=
BASE_SEPOLIA_ESCROW_DEPLOY_BLOCK=0
# Same key as RELAYER_PRIVATE_KEY above (signs on a different chain).
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=

# --- Optional read cache (Redis / Upstash) ---
# Best-effort only — never load-bearing. Leave blank to disable caching
# entirely; jobs and payout logic are Postgres-backed regardless.
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=15

# --- Background jobs ---
DEADLINE_ENFORCER_INTERVAL_MS=60000
# Drives both the chain-write reconciler and the chain indexer's reconcile/
# discover/backfill pass. Keep this well above ~30s per machine — GenLayer
# Studio's shared RPC caps at 5000 gen_call/day, and each machine's idle tick
# costs at least one call (see config.ts). Set as a Fly secret in production
# (CHAIN_RECONCILER_INTERVAL_MS=180000), not just this default.
CHAIN_RECONCILER_INTERVAL_MS=180000
CHAIN_SYNC_MAX_ATTEMPTS=8
CHAIN_SYNC_BASE_BACKOFF_MS=2000
