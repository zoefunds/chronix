# Backend REST API base URL (see PLANNING.md — Fastify backend on Fly.io)
VITE_API_URL=http://localhost:8080

# GenLayer Intelligent Contract address (adjudication + ledger only — moves
# no money; see contracts/chronix.py). Set once you deploy it on GenLayer Studio.
VITE_CONTRACT_ADDRESS=

# GenLayer JSON-RPC endpoint (adjudication reads only).
VITE_CHAIN_RPC=https://studio.genlayer.com/api

# --- Base Sepolia (real USDC funding layer — contracts/base/ChronixEscrow.sol) ---
VITE_BASE_SEPOLIA_CHAIN_ID=84532
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_CHRONIX_ESCROW_ADDRESS=replace-with-deployed-ChronixEscrow-address

# WalletConnect v2 Cloud project ID (https://cloud.walletconnect.com/)
# required for the WalletConnect / Rainbow / Zerion connector.
VITE_WALLETCONNECT_PROJECT_ID=replace-with-your-walletconnect-project-id
