# Backend REST API base URL (see PLANNING.md — Fastify backend on Fly.io)
VITE_API_URL=http://localhost:8080

# GenLayer Intelligent Contract address — set once the user deploys the
# production contract manually (per PLANNING.md, "Contract runtime").
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# JSON-RPC endpoint for the chain the contract/escrow lives on.
VITE_CHAIN_RPC=https://replace-with-your-rpc-url

# WalletConnect v2 Cloud project ID (https://cloud.walletconnect.com/)
# required for the WalletConnect / Rainbow / Zerion connector.
VITE_WALLETCONNECT_PROJECT_ID=replace-with-your-walletconnect-project-id
